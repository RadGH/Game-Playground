      "telegraphs": [
        {
          "shape": "circle",
          "at": "farthest",
          "r": 3,
          "wind": 1.4,
          "damage": 1.6
        }
      ]
    },
    "laugh": {
      "id": "laugh",
      "name": "Pack Laugh",
      "every": [
        20,
        24
      ],
      "first": 7,
      "cast": 2,
      "interrupt": true,
      "say": "Hettie throws back her head to laugh — interrupt her!",
      "onInterrupt": [
        {
          "say": "Her laugh turns into hiccups.",
          "style": "emote"
