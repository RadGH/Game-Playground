      "actions": [
        {
          "adds": {
            "type": "vent_wisp",
            "count": 2,
            "radius": 6
          }
        },
        {
          "say": "Wisps of flame rise out of the kiln!",
          "style": "warn"
        }
      ]
    },
    "heat_wave": {
      "id": "heat_wave",
      "name": "Heat Waves",
      "every": [
        14,
        17
      ],
      "first": 3,
      "cast": 0.6,
