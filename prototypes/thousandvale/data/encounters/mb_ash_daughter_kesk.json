{
  "id": "mb_ash_daughter_kesk",
  "name": "Ash-Daughter Kesk",
  "tier": "miniboss",
  "body": "slagborn_firecaller",
  "place": "dungeon kiln_forge set B (The Slag Heaps): mini-boss",
  "_doc": "Chief Durrak's daughter, a firecaller still learning, which makes her careless with it. P1 \"Lessons\": fire bolts, a fire wall she draws on the floor (a line that stays as burning ground), and a long cast — Call the Ash — you must interrupt or she wraps herself in a burning shield. P2 at 50% \"Showing Off\": she throws fire everywhere: a cross of flame, burning rings around random players, and her shield cast comes faster.",
  "party": "Solo: keep an interrupt ready. 2-3: one interrupter, the rest spread. 5: as designed.",
  "hpMult": 1.9,
  "arena": {
    "radius": 12,
    "objects": []
  },
  "say": {
    "pull": [
      "\"Father says I need practice. Hold still.\"",
      "Kesk snaps her fingers twice before the fire catches. \"There!\""
    ],
    "death": "\"Father will...\" Kesk does not finish.",
    "reset": "\"Missed. Again.\" Kesk sulks back to the slag heaps."
  },
  "enrage": {
    "seconds": 260,
    "damage": 2.5,
    "say": "Kesk loses control of her fire!"
  },
