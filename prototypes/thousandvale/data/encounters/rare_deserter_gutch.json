      "first": 9,
      "cast": 2.5,
      "interrupt": true,
      "say": "Gutch bellows a rally — interrupt him!",
      "onInterrupt": [
        {
          "say": "His voice cracks mid-bellow.",
          "style": "emote"
        }
      ],
      "actions": [
        {
          "heal": 0.08
        },
        {
          "adds": {
            "type": "road_brigand",
            "count": 1,
            "radius": 6
          }
        }
      ]
    },
    "sweep": {
      "id": "sweep",
      "name": "Halberd Sweep",
      "every": [
        9,
        11
      ],
      "first": 2,
      "range": 6,
      "telegraphs": [
        {
          "shape": "cone",
          "at": "self",
          "r": 6,
          "arc": 2.4,
          "wind": 1.2,
          "damage": 1.9
        }
      ]
    }
  },
  "phases": [
    {
      "name": "Drill",
      "abilities": [
        "jab",
        "form_line",
        "volley",
        "rally"
      ]
