# Thousandvale OFF-MACHINE backup settings (PLAN §9.6). Lives at /etc/thousandvale/offsite.env, owner thousandvale, mode 0400.
# Read ONLY by thousandvale-offsite.service — the game server never loads it. Never copy it into the repo, ~/claude/secrets,
# a log or a chat. Fill it with:  sudoedit /etc/thousandvale/offsite.env   then:  sudo systemctl start thousandvale-offsite
#
# The key must be WRITE-ONLY (it can put objects under the prefix, nothing else — no list, no read, no delete):
#   R2: Cloudflare dashboard -> R2 -> Manage API tokens -> "Object Read & Write" scoped to this ONE bucket
#       (R2 has no pure write-only token today; scope it to the bucket and keep 14-day lifecycle + no public access).
#   S3: an IAM user with only  s3:PutObject  on  arn:aws:s3:::<bucket>/thousandvale/stable/*
# Retention: a bucket lifecycle rule deleting objects under the prefix after 14 days (set in the dashboard once).
TV_OFFSITE_ENDPOINT=@ENDPOINT@
# R2: https://<account-id>.r2.cloudflarestorage.com      S3: https://s3.<region>.amazonaws.com
TV_OFFSITE_REGION=@REGION@
# R2: auto      S3: the bucket's region, e.g. us-east-1
TV_OFFSITE_BUCKET=@BUCKET@
TV_OFFSITE_PREFIX=thousandvale/stable/
TV_OFFSITE_KEY_ID=@KEY_ID@
TV_OFFSITE_SECRET=@SECRET@
# Optional but recommended: encrypt before upload. Create once:  sudo sh -c 'head -c 48 /dev/urandom | base64 > /etc/thousandvale/offsite.pass'
# (chown thousandvale, chmod 0400) and store a copy of that line in the owner's password manager.
#TV_OFFSITE_PASSFILE=/etc/thousandvale/offsite.pass
