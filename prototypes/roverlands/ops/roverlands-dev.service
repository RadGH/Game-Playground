# Roverlands DEV server: the live working tree on port 8551 (+ https 8553 for gamepads). LAN only. User unit.
# Installed by ops/install.sh. Restart after changing anything under server/, js/net/ or data/vehicles.json:
#   systemctl --user restart roverlands-dev
[Unit]
Description=Roverlands dev server (working tree) on :8551
After=network-online.target
[Service]
Type=simple
ExecStart=%h/claude/playground/prototypes/roverlands/ops/start.sh dev
Restart=on-failure
RestartSec=2
[Install]
WantedBy=default.target
