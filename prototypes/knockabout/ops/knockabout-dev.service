# Knockabout DEV server: the live working tree on port 8471 (+ https 8473 for gamepads). LAN only. User unit.
# Installed by ops/install.sh. Restart after changing anything under server/, js/net/, js/sim/ or data/:
#   systemctl --user restart knockabout-dev
[Unit]
Description=Knockabout dev server (working tree) on :8471
After=network-online.target
[Service]
Type=simple
ExecStart=%h/claude/playground/prototypes/knockabout/ops/start.sh dev
Restart=on-failure
RestartSec=2
[Install]
WantedBy=default.target
