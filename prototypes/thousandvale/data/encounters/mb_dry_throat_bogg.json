  "tier": "miniboss",
  "body": "sulphur_toad",
  "place": "dungeon lava_tube set B (The Dry Wells): floor 2's mini-boss",
  "_doc": "A huge toad that drank the last well dry and sits on its rim. P1 \"Thirst\": it spits yellow gobbets that leave stinging puddles; the old well windlass (a lever, repeatable) sloshes the last bucket of water out and washes the puddles away. P2 at 50% \"Bloat\": it swells, belches a cone, and leaps onto a player (a follow circle) with a croak that knocks everyone out.",
  "party": "Solo: wash the puddles every second spit. 2-3: one on the windlass. 5: spread for the leap — it lands where its target stands.",
  "hpMult": 2.1,
  "arena": {
    "radius": 12,
    "objects": [
      {
        "id": "windlass",
        "type": "lever",
        "name": "Well windlass",
        "x": 0,
        "z": -7,
        "repeat": true,
        "onUse": [
          {
            "remove": "spit_puddle"
          },
          {
            "say": "The last bucket sloshes across the floor — the puddles wash away.",
            "style": "emote"
          }
        ]
      }
    ]
  },
  "say": {
