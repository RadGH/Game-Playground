  "say": {
    "pull": [
      "HALT. The gates are CLOSED by order of the reeve.",
      "State your name for the roll. The drowned are owed a count.",
      "You are trespassing in the town cistern. The penalty is... the water."
    ],
    "death": "The Drowned Reeve lowers his mace. \"Gates... closed,\" he gurgles, and is still.",
    "reset": "The Reeve squelches back to his post by the gates."
  },
