    "pull": [
      "Leaves fall like rain. Something heavy is coming down with them.",
      "A low yowl from the canopy. Every bird goes quiet."
    ],
    "death": "The Canopy Widow falls out of the last tree and does not get up.",
    "reset": "The Canopy Widow climbs back into the dark green."
  },
