# Thousandvale STABLE server environment. Written by ops/setup-stable.sh from ops/stable.env.template.
# Lives at /etc/thousandvale/env, owner thousandvale, mode 0400. Never copy it into the repo, ~/claude/secrets, a log or a chat.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=thousandvale_stable
PGUSER=thousandvale_stable
PGPASSWORD=@PASSWORD@
TV_ENV=stable
TV_HOST=0.0.0.0
# Salt for the one-way hash of a banned player's address (server keeps only the hash). Random per install; changing it
# later makes existing address bans stop matching. Generated by setup-stable.sh; added to an older env file if missing.
TV_IP_SALT=@IP_SALT@
# Token for the admin page (127.0.0.1:8492 only; reach it with ssh -L 8492:127.0.0.1:8492). Read it with
#   sudo grep ^TV_ADMIN_TOKEN= /etc/thousandvale/env
TV_ADMIN_TOKEN=@ADMIN_TOKEN@
# Turnstile (human check on guest creation) stays OFF until the client draws the widget (stream D) — with it on and no
# widget, nobody could create a character. To turn it on: uncomment (Cloudflare's public TEST keys, or the real pair),
# remove /etc/systemd/system/thousandvale.service.d/lan-only.conf (the server must reach challenges.cloudflare.com),
# daemon-reload, restart.
#TV_TURNSTILE_SITEKEY=1x00000000000000000000AA
#TV_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
