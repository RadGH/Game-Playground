# Thousandvale stable database backup (stream H, PLAN §9.6). Run hourly by thousandvale-backup.timer.
[Unit]
Description=Thousandvale stable database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=thousandvale
Group=thousandvale
EnvironmentFile=/etc/thousandvale/env
ExecStart=/usr/local/lib/thousandvale/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/thousandvale
UMask=0077
