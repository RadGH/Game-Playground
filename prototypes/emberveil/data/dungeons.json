   "failText": "The light bleeds into you. The party emerges pale and shaking, HP sapped.",
   "passBuff": {
    "type": "stun_round1",
    "desc": "Enemies begin the next fight stunned."
   },
   "failDamagePct": 0.16
  },
  "spiracle_current": {
   "stat": "CON",
   "dc": 17,
