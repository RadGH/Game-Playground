{
  "schema": 1,
  "_doc": "Cell materials and the world rules that act on them. `list` order is FIXED (a cell stores the index); new materials append at the end. Times are in ticks (20 a second). Temperatures are the 0-255 cell byte; `tempCurve` maps it to degrees C. See README 'M1 - the cell world'.",
  "tempCurve": [[0, -60], [40, 0], [44, 2], [60, 20], [100, 150], [150, 380], [200, 700], [230, 1000], [255, 1400]],
  "ambient": 60,
  "fire": {
    "_doc": "A burning cell heats its 8 neighbours. Heat a neighbour gets = weight (side 4, diagonal half) x wind factor. A flammable cell's temperature rises by `gain` per 4 heat, where gain is worked out from its `ignite` ticks so ONE side neighbour in calm air lights it in exactly `ignite` ticks.",
    "igniteTop": 250,
    "fireTemp": 225,
    "diagWeight": 2,
    "sideWeight": 4,
    "windWeights": [[4, 4, 4, 4, 4], [8, 6, 4, 2, 1], [13, 8, 3, 1, 0], [18, 10, 2, 0, 0]],
    "_windDoc": "windWeights[strength][rel] for a side neighbour, rel = 0 downwind ... 4 upwind. Diagonals use the mean of their two sides, halved.",
    "wetHeat": 0.3,
    "coolPerTick": 3,
    "jitter": 0.35,
    "fuelJitter": 0.3,
    "rainOutChance": 0.04,
    "steamFromWater": 6,
    "hotBurnTo": 175
  },
  "gas": {
    "_doc": "Quarter-res gas layer (one value per 4x4 cells): density 0-255 + kind. Stepped every 2nd tick, awake gas chunks only.",
    "every": 2,
    "decay": 0.985,
    "diffuse": 0.34,
    "advect": [0, 0.22, 0.42, 0.62],
    "sleepBelow": 2,
    "kinds": ["none", "smoke", "steam", "ash"],
    "blindAt": 90
  },
  "blast": {
    "rubbleCore": 0.55,
    "scorchRing": 0.9,
    "edgeJitter": 0.18,
    "coreTemp": 250,
    "rimTemp": 140,
    "igniteChance": 0.55,
    "debrisPerCell": 0.22,
    "debrisSpeed": 1.4,
    "debrisLift": 1.1,
    "hotDebris": 0.3,
    "smoke": 70,
    "ash": 40,
    "steam": 120,
    "wallDamage": 30
  },
  "debris": {
    "max": 300,
    "landingsPerSecond": 80,
    "gravity": 0.09,
    "bounce": 0.35,
    "bounces": 1,
    "hotLandTemp": 210,
    "igniteChance": 0.5,
    "landSteam": 40
  },
  "frost": { "temp": 4, "putOut": true, "warmEvery": 20, "warmBy": 1, "meltTemp": 44 },
  "lightning": { "floodRadius": 48, "floodMax": 5000, "strikeTemp": 240, "seekWater": 3 },
  "wet": {
    "_doc": "Quarter-res wetness 0-255. Rain raises it; it dries every slow pass. A cell counts as wet at `wetAt` and above (bit 31). Bare soil turns to mud at `mudAt` and back at `dryAt`.",
    "rainPerSlow": 18,
    "dryPerSlow": 1,
    "wetAt": 60,
    "mudAt": 140,
    "dryAt": 40
  },
  "slow": { "every": 20, "regrowSamples": 24, "lightRadius": 5 },
