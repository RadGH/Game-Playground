{
  "_doc": "Sample game dictionary. Types declare which forms make sense; entries carry explicit forms (sg/pl/adj/people/lang/short), flags (proper = no article, mass = 'some'), pronouns (he/she/they/it), tags, references to other entries (race, faction, owner...), and optional pron { respell, ipa, espeak }. Games add their own entries at runtime with lexicon.add().",
  "types": {
    "person": {
      "forms": [
        "sg",
        "short"
      ],
      "refs": [
        "race",
        "faction",
        "title"
      ],
      "doc": "A named character. proper=true. pronouns set. race → race entry."
    },
    "race": {
      "forms": [
        "sg",
        "pl",
        "adj",
        "people",
        "lang"
      ],
      "doc": "elf / elves / elven / the Elves / Elvish"
    },
    "creature": {
      "forms": [
        "sg",
        "pl",
        "adj"
      ],
      "doc": "Monsters and animals."
    },
    "spell": {
      "forms": [
        "sg",
        "pl"
      ],
      "doc": "Magic. tags: school (fire, shadow…)"
    },
    "item": {
      "forms": [
        "sg",
        "pl"
      ],
      "doc": "Objects, weapons, tools."
    },
    "food": {
      "forms": [
        "sg",
        "pl"
      ],
      "doc": "mass=true for uncountables (ale, bread)."
    },
    "place": {
      "forms": [
        "sg",
        "adj",
        "people"
      ],
      "doc": "Named places are proper; generic places (tavern) are not."
    },
    "faction": {
      "forms": [
        "sg",
        "pl",
        "adj",
        "people"
      ],
      "doc": "Guilds, clans, cults."
    },
    "deity": {
      "forms": [
        "sg",
        "adj"
      ],
      "doc": "Gods for oaths and curses. proper."
    },
    "title": {
      "forms": [
        "sg",
        "pl"
      ],
      "doc": "Job or rank: healer, captain."
    },
    "concept": {
      "forms": [
        "sg"
      ],
      "doc": "Abstract nouns for lore and insults: honor, rot, the Blight."
    },
    "weather": {
      "forms": [
        "sg"
      ],
      "doc": "For complaints."
    },
    "bodypart": {
      "forms": [
        "sg",
        "pl"
      ],
      "doc": "Injuries, insults."
    }
  },
