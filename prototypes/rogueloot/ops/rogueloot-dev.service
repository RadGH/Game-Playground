# Rogueloot DEV server: the live working tree on port 8581 (+ https 8583 for gamepads). LAN only. User unit.
# Installed by ops/install.sh. Restart after changing anything under server/, js/net/, js/sim/ or data/:
#   systemctl --user restart rogueloot-dev
[Unit]
Description=Rogueloot dev server (working tree) on :8581
After=network-online.target
[Service]
Type=simple
ExecStart=%h/claude/playground/prototypes/rogueloot/ops/start.sh dev
Restart=on-failure
RestartSec=2
[Install]
WantedBy=default.target
