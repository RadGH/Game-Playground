{
 "_doc": "Bannerline input bindings, one table per device TYPE. Actions are the vocabulary js/input/commands.js understands. Keyboard codes are KeyboardEvent.code; mouse buttons are Mouse0 (left), Mouse1 (middle), Mouse2 (right); WheelUp/WheelDown. Gamepad names are the standard-mapping button names in js/input/gamepad.js (M2). Per-device overrides are saved in localStorage (shared/store.js, namespace bannerline) and merged over these.",
 "keyboard": {
  "join":        ["Enter", "Space"],
  "leave":       ["Escape"],
  "select":      ["Mouse0"],
  "move":        ["Mouse2"],
  "attackMove":  ["KeyA"],
  "stop":        ["KeyS"],
  "skillQ":      ["KeyQ"],
  "skillW":      ["KeyW"],
  "skillE":      ["KeyE"],
  "skillD":      ["KeyD"],
  "skillR":      ["KeyR"],
  "belt1":       ["Digit1"],
  "belt2":       ["Digit2"],
  "send1":       ["KeyZ"],
  "send2":       ["KeyX"],
  "send3":       ["KeyC"],
  "send4":       ["KeyV"],
  "autoMod":     ["ShiftLeft", "ShiftRight"],
  "centre":      ["Space"],
  "shop":        ["KeyB"],
  "character":   ["KeyI"],
  "muster":      ["KeyM"],
  "upgrade":     ["KeyG"],
  "scoreboard":  ["Tab"],
  "pause":       ["Escape", "F10"],
  "zoomIn":      ["WheelUp", "Equal", "NumpadAdd"],
  "zoomOut":     ["WheelDown", "Minus", "NumpadSubtract"],
  "panDrag":     ["Mouse1"],
  "panUp":       ["ArrowUp"],
  "panDown":     ["ArrowDown"],
  "panLeft":     ["ArrowLeft"],
  "panRight":    ["ArrowRight"]
 },
 "gamepad": {
  "_doc": "M2. Left stick moves (moveDir), right stick aims (centred = auto-target). LB + d-pad = deck sends; LB held + d-pad held = toggle auto-send.",
  "join":        ["A", "Start"],
  "leave":       ["B"],
  "attack":      ["A"],
  "skillQ":      ["X"],
  "skillW":      ["Y"],
  "skillE":      ["B"],
  "skillD":      ["RB"],
  "skillR":      ["RT"],
  "deckMod":     ["LB"],
  "send1":       ["DUp"],
  "send2":       ["DRight"],
  "send3":       ["DDown"],
  "send4":       ["DLeft"],
  "belt1":       ["DLeft"],
  "belt2":       ["DRight"],
  "character":   ["View"],
  "pause":       ["Menu"],
  "cycleSelect": ["R3"]
 }
}
