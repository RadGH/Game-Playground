  "party": {
    "solo": "Solo-able if you keep cover near.",
    "small": "Easy.",
    "full": "Easy.",
    "m5": "M5 adds health per extra player and one more copy of the spread/scatter shapes for parties of 4-5; mechanics stay the same."
  },
  "hpMult": 1.9,
  "arena": {
    "radius": 26
  },
  "say": {
    "pull": [
      "The humming gets louder. The crystal turns to face you.",
      "Green light falls across you. The grass at your feet stands up."
    ],
    "death": "The Green Shard cracks down the middle and falls into the sinkhole.",
    "reset": "The Shard goes back to humming over the sinkhole."
  },
  "abilities": {
    "pulse": {
      "id": "pulse",
      "name": "Pulse",
      "every": [
        7,
        9
