{
  "_doc": "The arena court's people, in data/npcs.json's format (js/world/quests.js). Their spots come from data/arena/towns.json. The Arena Master opens the bracket board and the champions' ladder (server/arena.js).",
  "npcs": {
    "arena_master": { "name": "Arena Master", "title": "Keeper of the board", "role": true, "place": "arena_court", "at": [7, 110], "body": { "kind": "tabard", "sex": "male", "age": "old", "outfit": "plate", "colour": "#6b2a2a", "fallback": "male" }, "lines": [{ "say": ["Name your bracket and I'll open the gates. The sand doesn't care what level you are, but the monsters do."] }], "services": [{ "kind": "arena", "text": "Show me the bracket board." }, { "kind": "ladder", "text": "Show me the champions." }] },
    "arena_smith": { "name": "Arena Smith", "role": true, "title": "Arms and armour", "place": "arena_court", "at": [-13, 128], "body": { "kind": "tabard", "sex": "female", "age": "middle", "outfit": "cloth", "colour": "#5a4a3a", "fallback": "female" }, "lines": [{ "say": ["Dents out, edges on. Next match starts when you're ready, not before."] }], "services": [{ "kind": "shop", "sells": ["weapon", "armour"], "levels": "hero" }, { "kind": "repair", "text": "Mend my gear." }] },
    "arena_goods": { "name": "Provisioner", "role": true, "title": "Rings, charms and wands", "place": "arena_court", "at": [13, 128], "body": { "kind": "tabard", "sex": "male", "age": "young", "outfit": "cloth", "colour": "#8c7a3c", "fallback": "male" }, "lines": [{ "say": ["Lucky charms! Half of them work. I won't say which half."] }], "services": [{ "kind": "shop", "sells": ["jewellery", "magic", "armour"], "levels": "hero" }] },
    "arena_trainer": { "name": "Class Trainer", "role": true, "title": "Every road, one teacher", "place": "arena_court", "at": [-8, 118], "body": { "kind": "tabard", "sex": "female", "age": "middle", "outfit": "leather", "colour": "#4a5a7a", "fallback": "female" }, "lines": [{ "say": ["Lost a match? Change your steps, not your heart. I can help with both."] }], "services": [{ "kind": "trainer", "classes": ["warrior", "ranger", "rogue", "mage", "cleric", "druid", "bard", "shaman"] }, { "kind": "respec", "text": "Help me choose a new path (respec)." }] }
  }
}
