# Thousandvale server environment — EXAMPLE. Copy the lines you need into the env file OUTSIDE the repo
# that the unit loads (dev: ~/.config/thousandvale/dev.env, stable: /etc/thousandvale/env, mode 600/400).
# Never put a real secret in this file or anywhere in the repo.

# Postgres (libpq variables; the pg package reads them)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=thousandvale_dev        # stable: thousandvale_stable (main.mjs refuses a mismatch, see --env)
# PGUSER=thousandvale
# PGPASSWORD=...

# Cloudflare Turnstile on guest creation. These are Cloudflare's PUBLIC TEST keys (always pass); the real
# pair is created in the Cloudflare dashboard at M3 and lives only in /etc/thousandvale/env.
# TV_TURNSTILE_SITEKEY=1x00000000000000000000AA
# TV_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Which deployment this is: dev | stable (default: stable on port 8490, dev otherwise)
# TV_ENV=dev
