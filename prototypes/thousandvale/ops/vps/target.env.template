# Thousandvale VPS target — copy to ops/vps/target.env (git-ignored) and fill in. Read by install.sh, deploy.sh, rollback.sh.
# Nothing secret lives here: logins use your SSH key (~/.ssh), never a password in a file.
TV_VPS_HOST=203.0.113.10          # the VPS's IP address (or play.example.com once DNS works)
TV_VPS_DOMAIN=play.example.com    # the address players type; Caddy gets a certificate for it
TV_VPS_EMAIL=you@example.com      # Let's Encrypt sends certificate-expiry warnings here (rare; Caddy renews on its own)
TV_VPS_KEY=~/.ssh/thousandvale_vps   # private key on this VM for ssh to the VPS (install.sh makes it if missing)
