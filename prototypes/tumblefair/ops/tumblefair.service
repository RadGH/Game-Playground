# Tumblefair STABLE server: the published copy (tools/publish-tumblefair.sh) on port 8480. User unit.
# LAN testing copy. The public game runs on the games.radgh.com droplet (https://tumblefair.games.radgh.com/).
[Unit]
Description=Tumblefair stable server (published copy) on :8480
After=network-online.target
[Service]
Type=simple
ExecStart=%h/claude/playground/prototypes/tumblefair/ops/start.sh stable
Restart=on-failure
RestartSec=2
[Install]
WantedBy=default.target
