{
  "id": "rare_the_glazier",
  "name": "The Glazier",
  "tier": "rare",
  "secret": true,
  "zone": "glasswind_strand",
  "level": 15,
  "body": "obsidian_warden",
  "place": "stands at a cold furnace in the glass king's ruins north of Shardhaven, still trying to make windows",
  "_doc": "Expansion 1 (Vharlen). A construct that made the Glass Kings' windows. It blows molten glass down a long pipe (a line of fire), drops gathers of hot glass on its target, and flings cooling water at everyone (chills). At half health it anneals: a cross of shattering panes that turns, and a hail of glass over the area.",
  "party": {
    "solo": "Fair solo at 15.",
    "small": "Right for 2-3.",
    "full": "Easy.",
    "m5": "M5 adds health per extra player and one more copy of the spread/scatter shapes for parties of 4-5; mechanics stay the same."
  },
  "hpMult": 2,
  "arena": {
    "radius": 24
  },
  "say": {
    "pull": [
      "The furnace door swings open. The Glazier turns round with its pipe.",
      "A whine of grinding glass. The statue at the furnace moves."
    ],
    "death": "The Glazier cracks from top to bottom and falls in pieces.",
    "reset": "The Glazier turns back to its cold furnace."
  },
  "abilities": {
    "pipe_swing": {
      "id": "pipe_swing",
      "name": "Pipe Swing",
      "every": [
        6,
        8
