# Kokoro voice service for the Voice Lab: natural-sounding TTS on 127.0.0.1:8402 (tools/serve.py forwards /api/kokoro/*).
# Install / update:  cp tools/kokoro-tts.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now kokoro-tts
# Restart after changing voice-lab/server/:  systemctl --user restart kokoro-tts      Logs: journalctl --user -u kokoro-tts -f
# Needs: (cd voice-lab/server && npm install) and tools/fetch-kokoro.sh fp32 (model files; falls back to Hugging Face).
[Unit]
Description=Kokoro TTS service for the playground Voice Lab on :8402
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/claude/playground/voice-lab/server
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node %h/claude/playground/voice-lab/server/kokoro-server.mjs
Nice=5
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
