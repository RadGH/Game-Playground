      "say": "\"Fine! I'll do it MYSELF!\"",
      "abilities": [
        "sweep",
        "form_line",
        "volley",
        "rally"
      ],
      "onEnter": [
        {
          "adds": {
            "type": "road_brigand",
            "count": 2,
            "radius": 8
          }
        }
      ]
