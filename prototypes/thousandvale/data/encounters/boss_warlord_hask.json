  "say": {
    "pull": [
      "\"Lord Hask will see you now. Lord Hask is going to kill you now.\"",
      "\"You walked all the way up here? Brave. Stupid, but brave.\"",
      "\"Red Banner! On your feet!\""
    ],
    "death": "Warlord Hask falls across his own war table. The red banner slips off its pole and covers him.",
    "reset": "\"Get them out of my keep.\""
  },
  "enrage": {
    "seconds": 330,
    "damage": 3,
    "say": "\"EVERYONE DIES TODAY!\""
