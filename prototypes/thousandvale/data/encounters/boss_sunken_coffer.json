  "say": {
    "pull": [
      "The strongbox creaks open. Inside, where the coins should be, there are teeth.",
      "\"PAYMENT,\" says the box. \"IS. DUE.\"",
      "Kerr-CHUNK. The lock turns by itself."
    ],
    "death": "The Sunken Coffer spits out one last coin and falls open, empty at last.",
    "reset": "The Coffer snaps shut. \"Account... closed.\""
  },
  "enrage": {
    "seconds": 330,
    "damage": 3,
    "say": "\"FORECLOSURE.\""
  },
