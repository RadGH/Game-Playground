{
  "name": "thousandvale",
  "version": "0.0.1",
  "private": true,
  "description": "Thousandvale: browser open-world MMO RPG (playground prototype). Server deps only; the client needs no build.",
  "author": "Radley Sustaire",
  "type": "module",
  "scripts": {
    "dev": "node server/main.mjs --port 8491",
    "test:unit": "node --test tests/*/*.test.js",
    "test:perf": "TV_PERF=1 node --test --test-concurrency=1 tests/A/bots20.test.js tests/A/bots50.test.js tests/A/bots100.test.js",
    "test:a": "node --test tests/A/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  }
}
