# Oathwild world server (dev) on :8661 (+ wss 8663). User unit, LAN only. OFF by default (owner 2026-11-16): start it while
# working on the game with playground/tools/game-servers.sh start oathwild-dev. The public game's rooms run on the
# games.radgh.com droplet (wss://games.radgh.com/ws/oathwild) once it is published.
[Unit]
Description=Oathwild world server (dev) on :8661
After=network-online.target
[Service]
Type=simple
ExecStart=%h/claude/playground/prototypes/oathwild/ops/start.sh dev
Restart=on-failure
RestartSec=2
[Install]
WantedBy=default.target
