{
  "id": "rare_the_last_keeper",
  "name": "The Last Keeper",
  "tier": "rare",
  "secret": true,
  "zone": "the_caldera",
  "level": 20,
  "body": "obsidian_warden",
  "place": "guards the shrine stair below Rim Shrine; the last of the old rim keepers, still on watch after its order is gone",
  "_doc": "Expansion 1 (Vharlen). The last guardian of the rim keepers. Its halberd sweeps a cone, it drives a long line down the stair, and it calls the old wards: three sigils on the ground, and only those standing in one are spared. At half health it keeps its last watch: an oath two players must share, falling stair stones and a turning cross of light.",
  "party": {
    "solo": "Hard solo at 20 (the oath wants a second player).",
    "small": "Right for 2-3.",
    "full": "Fair.",
    "m5": "M5 adds health per extra player and one more copy of the spread/scatter shapes for parties of 4-5; mechanics stay the same."
  },
  "hpMult": 2.2,
  "arena": {
    "radius": 24
  },
  "say": {
    "pull": [
      "'None pass to the crater. None.'",
      "The statue on the stair lowers its halberd."
    ],
    "death": "The Last Keeper kneels on the stair. 'Relieved... at last.'",
    "reset": "The Last Keeper returns to its step and stands still."
  },
