      "abilities": [
        "cleaver",
        "burning_floor",
        "table_soak",
        "rally",
        "last_cross"
      ]
    }
  ],
  "triggers": [
    {
      "when": {
        "lit": 3,
        "phase": 1
      },
      "do": [
        {
          "shield": false
        },
        {
          "stun": 4
        },
        {
          "vuln": {
            "takeMore": 0.4,
            "seconds": 10,
            "name": "Wall Broken"
          }
        },
        {
          "say": "The old garrison bell booms — the shield wall scatters!",
          "style": "warn"
        }
      ]
    },
    {
      "when": {
        "broken": 2
      },
      "do": [
        {
          "remove": "banner_aura_a"
        },
        {
          "remove": "banner_aura_b"
        },
        {
          "say": "Both red banners are down! Hask has nowhere to rally!",
          "style": "warn"
        }
      ]
    }
  ]
