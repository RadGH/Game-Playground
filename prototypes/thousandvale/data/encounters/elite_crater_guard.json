    "pull": [
      "The black statue at the crater path turns its head.",
      "'The wyrm sleeps. You will not wake it.'"
    ],
    "death": "The Crater Guard topples off the path and shatters on the rocks below.",
    "reset": "The Crater Guard steps back to its post."
  },
