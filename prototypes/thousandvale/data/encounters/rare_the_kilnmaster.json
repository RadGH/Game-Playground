{
  "id": "rare_the_kilnmaster",
  "name": "The Kilnmaster",
  "tier": "rare",
  "secret": true,
  "zone": "kiln_ridge",
  "level": 18,
  "body": "obsidian_warden",
  "place": "tends the one old kiln that never went out, out in the scrub near Kilnhold",
  "_doc": "Expansion 1 (Vharlen). A construct built to fire the old kilns, still firing them. It opens the kiln door in a wide cone of heat, fires every player like a pot (a circle that follows each of you), and stokes — an interruptible cast that wakes vent wisps if it finishes. At half health the kiln reaches full heat: waves of heat roll outward and clay shards fly in a cross.",
  "party": {
    "solo": "Hard solo at 18: interrupt the stoking.",
    "small": "Right for 2-3.",
    "full": "Easy.",
    "m5": "M5 adds health per extra player and one more copy of the spread/scatter shapes for parties of 4-5; mechanics stay the same."
  },
  "hpMult": 2,
  "arena": {
    "radius": 24
  },
  "say": {
    "pull": [
      "The Kilnmaster turns from the kiln. Its hands are glowing.",
      "A grinding voice: \"Next batch.\""
    ],
    "death": "The Kilnmaster stops mid-step. The kiln behind it finally goes out.",
    "reset": "The Kilnmaster goes back to stoking."
  },
  "abilities": {
    "tongs": {
      "id": "tongs",
      "name": "Kiln Tongs",
      "every": [
        6,
        8
      ],
      "first": 2,
      "range": 5,
      "telegraphs": [
        {
          "shape": "cone",
          "at": "self",
          "r": 4.6,
          "arc": 1.3,
          "wind": 1,
          "damage": 1.7
        }
      ]
    },
    "kiln_door": {
      "id": "kiln_door",
      "name": "Kiln Door",
      "every": [
        12,
        15
      ],
      "first": 4,
      "cast": 0.6,
      "say": "It throws open the kiln door — get out of the front!",
      "telegraphs": [
        {
          "shape": "cone",
          "at": "self",
          "r": 10,
          "arc": 1.4,
          "wind": 1.4,
          "damage": 1.8,
          "element": "fire",
          "status": "seared"
        }
      ]
    },
    "firing": {
      "id": "firing",
      "name": "Firing",
      "every": [
        14,
        17
      ],
      "first": 7,
      "cast": 0.5,
      "say": "Everyone is going in the kiln — spread out!",
      "telegraphs": [
        {
          "shape": "circle",
          "at": "each",
          "r": 2.6,
          "wind": 2.2,
          "damage": 1.3,
          "follow": true,
          "element": "fire",
          "status": "burn"
        }
      ]
