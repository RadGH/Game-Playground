      "telegraphs": [
        {
          "shape": "line",
          "at": "self",
          "len": 18,
          "w": 2.4,
          "wind": 1.3,
          "damage": 1.8,
          "element": "fire",
          "status": "burn"
        }
      ]
    },
    "gather": {
      "id": "gather",
      "name": "Hot Gather",
      "every": [
        10,
        13
      ],
      "first": 7,
      "telegraphs": [
        {
          "shape": "circle",
