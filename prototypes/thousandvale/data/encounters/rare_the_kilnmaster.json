      "telegraphs": [
        {
          "shape": "donut",
          "at": "self",
          "r": 8,
          "r2": 3,
          "wind": 1.4,
          "damage": 1.5,
          "element": "fire"
        },
        {
          "shape": "donut",
          "at": "self",
          "r": 15,
          "r2": 9,
          "wind": 1.4,
          "damage": 1.5,
          "element": "fire",
          "after": 1.2
        }
      ]
