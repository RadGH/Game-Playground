          }
        },
        {
          "say": "Hask hides behind a shield wall! Light all three signal fires to ring the garrison bell!",
          "style": "warn"
        }
      ]
    },
    {
      "name": "The Red Banner Falls",
      "newBar": {
        "hp": 0.55
      },
