# Thousandvale weekly RESTORE DRILL (stream H, PLAN §9.6: "the restore drill is a test, not a promise").
# Restores the newest backup into the scratch database thousandvale_drill_dev, boots the published server on it
# (127.0.0.1:8493, --env dev --process drill), waits for /healthz, runs the conservation check, stops it.
# Result: /var/backups/thousandvale/drill-last.txt and the journal (journalctl -u thousandvale-drill).
[Unit]
Description=Thousandvale restore drill
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=thousandvale
Group=thousandvale
EnvironmentFile=/etc/thousandvale/env
ExecStart=/usr/local/lib/thousandvale/restore-drill.sh
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/thousandvale /opt/thousandvale
ReadWritePaths=/var/backups/thousandvale /var/lib/thousandvale
UMask=0077
