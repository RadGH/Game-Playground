  "say": {
    "pull": [
      "A little light bobs out of the dark. \"Mind the step,\" it whispers. Then it burns.",
      "\"Shift's over,\" says the lamp. \"Everybody out. EVERYBODY.\""
    ],
    "death": "The Drowned Lamp gutters, flickers, and goes out with a sigh.",
    "reset": "The light drifts back to its hook and dims."
  },
  "enrage": {
    "seconds": 300,
    "damage": 2.5,
    "say": "The Lamp flares white-hot!",
    "soft": {
      "from": 180,
      "every": 15,
      "add": 0.08,
      "say": "The light is getting hotter."
    }
  },
