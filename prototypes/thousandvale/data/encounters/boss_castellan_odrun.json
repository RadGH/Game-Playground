  "say": {
    "pull": [
      "\"I swore to hold this keep. I never said for whom.\"",
      "\"Guards! We have guests in the hall.\"",
      "\"Kneel, or be knelt.\""
    ],
    "death": "Castellan Odrun drops his halberd. \"I... was keeping it... safe,\" he lies, and dies.",
    "reset": "\"Close the gates. Again.\""
  },
  "enrage": {
    "seconds": 330,
    "damage": 3,
    "say": "\"NO QUARTER! BURN THE HALL!\""
  },
