  "arena": {
    "radius": 26
  },
  "say": {
    "pull": [
      "The Ash Reaver lifts his glass scythe. It catches the light like water.",
      "'Harvest's in. You're the last of it.'"
    ],
    "death": "The Ash Reaver falls and his scythe breaks into a hundred black pieces.",
    "reset": "The Ash Reaver walks back into the ash."
  },
