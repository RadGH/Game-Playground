{
  "id": "rare_laughing_hettie",
  "name": "Laughing Hettie",
  "tier": "rare",
  "zone": "millbrook",
  "body": "crag_hyena",
  "place": "leads a pack in the gorse above Three Wheels and steals lambs, laughing",
  "_doc": "Stream E (M2). A hyena matriarch whose laugh calls the pack. She snaps at the weakest (a circle on the farthest player), her laugh is an interruptible cast that brings two more hyenas, and at half health she circles: a ring that closes in, then a pounce.",
  "party": {
    "solo": "Solo-able if you interrupt the laugh.",
    "small": "Easy.",
    "full": "Easy.",
    "m5": "M5 adds health per extra player and one more copy of the spread/scatter shapes for parties of 4-5; mechanics stay the same."
  },
  "hpMult": 1.7,
  "arena": {
    "radius": 24
  },
  "say": {
    "pull": [
      "A cackle from the gorse. Then another. Then lots.",
      "Hettie grins. It is not a nice grin."
    ],
    "death": "Laughing Hettie stops laughing.",
    "reset": "Hettie slinks away, giggling."
  },
  "abilities": {
    "snap": {
      "id": "snap",
      "name": "Snap",
      "every": [
        6,
        8
      ],
      "range": 4.5,
      "telegraphs": [
        {
          "shape": "cone",
          "at": "self",
          "r": 4,
          "arc": 1.4,
          "status": "bleed",
          "wind": 0.9,
          "damage": 1.5
        }
      ]
    },
    "pick_off": {
      "id": "pick_off",
      "name": "Pick Off",
