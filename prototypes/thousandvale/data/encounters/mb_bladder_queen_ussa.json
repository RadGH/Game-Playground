    "pull": [
      "Something huge and round bobs up out of the black water, croaking.",
      "The water smells of eggs and lamp oil."
    ],
    "death": "Ussa sinks with a sad little burp.",
    "reset": "Ussa bobs back out to the middle of the pool."
  },
  "enrage": {
