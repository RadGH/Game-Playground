# Thousandvale NAMED Cloudflare tunnel (stream H, PLAN §11.3) — a SYSTEM unit, installed by
# ops/tunnel/named/setup-named.sh into /etc/systemd/system/. Installed DISABLED and STOPPED; the lead starts it only after
# `sudo ops/lib/check-public.sh --mode named --confirm-manual` passes.
# KILL SWITCH: sudo systemctl stop thousandvale-tunnel
#
# Runs as a throw-away systemd user (DynamicUser): it cannot read /home, /etc/thousandvale or the database.
# The tunnel credentials (/etc/cloudflared/thousandvale-tunnel.json, root 0600) are handed in by LoadCredential and
# appear only inside this unit at /run/credentials/thousandvale-tunnel.service/tunnel.json.

[Unit]
Description=Thousandvale named tunnel -> 127.0.0.1:8490
After=network-online.target thousandvale.service
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
LoadCredential=tunnel.json:/etc/cloudflared/thousandvale-tunnel.json
ExecStart=@CLOUDFLARED@ tunnel --config /etc/cloudflared/thousandvale.yml run
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
