{
  "id": "boss_chief_durrak",
  "name": "Chief Durrak Brandhand",
  "tier": "boss",
  "body": "slagborn_chief",
  "place": "dungeon kiln_forge set B (The Slag Heaps, Kiln Ridge, level 17-20): the end boss in the great forge",
  "_doc": "The Slagborn war-chief of Kiln Ridge, who forges the gangs' weapons himself. P1 \"At the Anvil\": a hammer cone, a red-hot brand he presses on the tank (stacks; swap at 3), and sparks off the anvil. Two slag-cooling pillars: his Forge Blast (hide behind one) cracks them. P2 at 60% \"Call the Smiths\": his smiths come running (a shield that holds while they live) while molten iron is poured from the crucible in lines. P3 new bar \"Quenched in Anger\": he plunges into the quench tank and comes out steaming — steam on each player, a three-player stack, and a hammer slam that knocks far.",
  "party": "Solo: hard — the brand needs a tank swap or a follower. 2-3: two tanks if you can. 5: as designed.",
  "hpMult": 4,
  "arena": {
    "radius": 16,
    "objects": [
      {
        "id": "cooler_a",
        "type": "pillar",
        "name": "Slag cooler",
        "x": -7,
        "z": 4,
        "r": 1.5,
        "hp": 3
      },
      {
        "id": "cooler_b",
        "type": "pillar",
        "name": "Slag cooler",
        "x": 7,
        "z": 4,
        "r": 1.5,
        "hp": 3
      }
    ]
  },
  "say": {
    "pull": [
      "\"New steel for the anvil.\"",
      "Durrak sets down a blade, picks up a hammer. \"Hold them still, I want to see the temper.\"",
      "\"Every Slagborn blade on this ridge, I made. Every one.\""
    ],
    "death": "Durrak drops his hammer on the anvil. It rings for a long time.",
    "reset": "\"Back to work.\" Durrak picks up the blade he was finishing."
  },
  "enrage": {
    "seconds": 340,
    "damage": 3,
    "say": "\"ENOUGH. Into the fire with all of you!\""
