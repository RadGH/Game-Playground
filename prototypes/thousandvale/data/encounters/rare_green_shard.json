{
  "id": "rare_green_shard",
  "name": "The Green Shard",
  "tier": "rare",
  "zone": "sunken_wolds",
  "body": "glass_shard",
  "place": "hangs over a sinkhole in the Sunken Wolds, humming; plants grow strangely in its light",
