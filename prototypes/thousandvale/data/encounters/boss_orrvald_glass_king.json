  "say": {
    "pull": [
      "\"Who opens the king's door without knocking?\"",
      "Sand runs off Orrvald like water as he stands. \"I was the first. I will be the last.\"",
      "\"Kneel. Or be buried.\""
    ],
    "death": "Orrvald's glass coat falls away in pieces, and there is only dry bone inside.",
    "reset": "Orrvald lies back down on his slab. \"Wake me again, and see.\""
  },
