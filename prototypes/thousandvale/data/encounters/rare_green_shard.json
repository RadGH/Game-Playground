      "range": 20,
      "telegraphs": [
        {
          "shape": "circle",
          "at": "target",
          "r": 2.8,
          "element": "arcane",
          "wind": 1.2,
          "damage": 1.6
        }
      ]
    },
    "sweep": {
      "id": "sweep",
      "name": "Turning Beam",
      "every": [
        13,
        16
      ],
      "first": 4,
      "cast": 0.6,
      "say": "The beam begins to turn!",
      "telegraphs": [
        {
          "shape": "line",
          "at": "self",
          "len": 22,
          "w": 2.4,
          "count": 5,
          "rotate": 0.5,
          "delay": 0.3,
          "element": "arcane",
          "wind": 1.2,
          "damage": 1.7
        }
      ]
    },
    "shatter": {
      "id": "shatter",
      "name": "Shed Shards",
      "every": [
        18,
        21
